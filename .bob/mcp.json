{
  "mcpServers": {
    "calendar-api": {
      "command": "${workspaceFolder}/.build/release/CalendarMCP.app/Contents/MacOS/CalendarMCP",
      "args": [],
      "env": {
        "CALENDAR_NAME": "Calendar"
      },
      "timeout": 30000,
      "alwaysAllow": [
        "get_event",
        "get_freebusy",
        "list_calendars",
        "list_events"
      ],
      "disabled": false
    }
  }
}